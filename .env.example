# Local development
NODE_ENV=development
DATABASE_URL=file:./prisma/dev.db

# Production Turso/libSQL
# Use the libsql:// URL from the Turso database and its auth token.
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=

# Auth secrets (generate long random values)
ADMIN_AUTH_SECRET=
CUSTOMER_AUTH_SECRET=

# Paystack
PAYSTACK_SECRET_KEY=

# Transactional email (optional; email sending is disabled without RESEND_API_KEY)
RESEND_API_KEY=
RESEND_FROM_EMAIL=
RESEND_REPLY_TO=
SUPPORT_EMAIL=

# Public site URL (used for metadata and email links)
NEXT_PUBLIC_SITE_URL=
NEXT_PUBLIC_APP_URL=

# Cloudflare R2 uploads (optional until product image uploads are needed)
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
R2_PUBLIC_URL=

# Shipbubble shipping rates and labels (required for real delivery quotes/waybills)
SHIPBUBBLE_API_KEY=
# Optional: defaults to Fashion Wears category ID 98246239
SHIPBUBBLE_CATEGORY_ID=98246239
# Never enable mock mode in production
SHIPBUBBLE_MOCK_MODE=false

# Address autocomplete providers (optional; either can be configured)
GEOAPIFY_API_KEY=
LOKATE_API_KEY=
