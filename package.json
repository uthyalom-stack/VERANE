{
  "name": "verane",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "dev": "next dev",
    "db:init": "node scripts/init-turso-db.mjs",
    "build": "npx prisma@5 generate && next build",
    "start": "next start",
    "test": "node tests/run_all_tests.mjs",
    "cf:install": "npm install --include=dev --no-save --package-lock=false @opennextjs/cloudflare@latest wrangler@latest",
    "cf:build": "npm run cf:install && npx prisma@5 generate && opennextjs-cloudflare build",
    "cf:preview": "npm run cf:build && opennextjs-cloudflare preview",
    "cf:deploy": "npm run cf:build && opennextjs-cloudflare deploy",
    "cf:typegen": "wrangler types --env-interface CloudflareEnv cloudflare-env.d.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1117.0",
    "@libsql/client": "^0.8.0",
    "@prisma/adapter-libsql": "^5.22.0",
    "@prisma/client": "^5.22.0",
    "html2canvas": "^1.4.1",
    "jspdf": "^4.2.1",
    "next": "16.4.6",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "resend": "^6.25.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "prisma": "^5.22.0",
    "tailwindcss": "^4"
  }
}