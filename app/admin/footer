"use client";

import { useEffect, useState } from "react";

const DEFAULT_FOOTER = {
  enabled: true,
  description:
    "Two brands. One expression. Crafted for those who appreciate individuality, quality and detail.",
  copyright: "© 2026 VÉRANE. All rights reserved.",
  newsletterEnabled: true,
  newsletterTitle: "Stay in the know.",
  newsletterText:
    "Be the first to discover new collections, exclusive releases and stories from VÉRANE.",
  instagram: "",
  facebook: "",
  tiktok: "",
  whatsapp: "",
};

export default function FooterPage() {
  const [footer, setFooter] = useState(DEFAULT_FOOTER);
  const [loading, setLoading] = useState(true);
  const [saving, setSaving] = useState(false);
  const [saved, setSaved] = useState(false);
  const [error, setError] = useState("");

  useEffect(() => {
    try {
      const stored = localStorage.getItem("verane_footer");

      if (stored) {
        const parsed = JSON.parse(stored);

        if (parsed && typeof parsed === "object") {
          setFooter({
            ...DEFAULT_FOOTER,
            ...parsed,
          });
        }
      }
    } catch (error) {
      console.error("Footer loading error:", error);
    } finally {
      setLoading(false);
    }
  }, []);

  function updateField(key, value) {
    setFooter((current) => ({
      ...current,
      [key]: value,
    }));

    setSaved(false);
    setError("");
  }

  function saveFooter() {
    try {
      setSaving(true);
      setError("");

      localStorage.setItem(
        "verane_footer",
        JSON.stringify(footer)
      );

      setSaved(true);

      setTimeout(() => {
        setSaved(false);
      }, 3000);
    } catch (error) {
      console.error("Footer saving error:", error);
      setError("Unable to save footer settings.");
    } finally {
      setSaving(false);
    }
  }

  if (loading) {
    return (
      <main className="min-h-screen bg-black px-5 py-10 text-white sm:px-8">
        <div className="mx-auto max-w-5xl animate-pulse">
          <div className="mb-10">
            <div className="h-3 w-28 rounded-full bg-white/10" />
            <div className="mt-4 h-12 w-64 rounded-xl bg-white/10" />
            <div className="mt-3 h-4 w-96 max-w-full rounded-full bg-white/5" />
          </div>

          <div className="space-y-6">
            <div className="h-72 rounded-[28px] bg-white/[0.04]" />
            <div className="h-80 rounded-[28px] bg-white/[0.04]" />
            <div className="h-72 rounded-[28px] bg-white/[0.04]" />
          </div>
        </div>
      </main>
    );
  }

  return (
    <main className="min-h-screen bg-black px-5 pb-32 pt-10 text-white sm:px-8 lg:px-10">
      <div className="mx-auto max-w-5xl">

        {/* HEADER */}
        <header className="mb-10">
          <div className="flex flex-col gap-7 sm:flex-row sm:items-end sm:justify-between">
            <div>
              <div className="mb-4 flex items-center gap-3">
                <span className="h-px w-9 bg-amber-400" />

                <span className="text-[10px] font-bold uppercase tracking-[0.32em] text-amber-400">
                  Content / Footer
                </span>
              </div>

              <h1 className="text-4xl font-semibold tracking-[-0.04em] sm:text-5xl">
                Footer
              </h1>

              <p className="mt-3 max-w-xl text-sm leading-6 text-white/40 sm:text-base">
                Shape the final impression customers see at the
                bottom of every VÉRANE page.
              </p>
            </div>

            <div
              className={`rounded-full border px-4 py-2 text-[10px] font-semibold uppercase tracking-[0.2em] ${
                footer.enabled
                  ? "border-emerald-400/20 bg-emerald-400/[0.04] text-emerald-300"
                  : "border-white/[0.08] bg-white/[0.025] text-white/30"
              }`}
            >
              {footer.enabled ? "Footer Active" : "Footer Hidden"}
            </div>
          </div>
        </header>

        {/* ERROR */}
        {error && (
          <div className="mb-6 flex items-center justify-between gap-4 rounded-2xl border border-red-400/20 bg-red-400/[0.06] px-5 py-4">
            <p className="text-sm text-red-300">
              {error}
            </p>

            <button
              onClick={() => setError("")}
              className="text-xs font-semibold text-white/40 transition hover:text-white"
            >
              Dismiss
            </button>
          </div>
        )}

        <div className="space-y-6">

          {/* GENERAL */}
          <section className="overflow-hidden rounded-[28px] border border-white/[0.08] bg-white/[0.025]">
            <div className="border-b border-white/[0.07] px-6 py-6 sm:px-8">
              <p className="text-[9px] font-bold uppercase tracking-[0.3em] text-amber-400/70">
                01 / General
              </p>

              <h2 className="mt-2 text-xl font-semibold">
                Footer Identity
              </h2>

              <p className="mt-1 text-sm text-white/35">
                Control the main information displayed in your footer.
              </p>
            </div>

            <div className="space-y-6 px-6 py-7 sm:px-8">

              {/* ENABLE */}
              <div className="flex items-center justify-between gap-5 rounded-2xl border border-white/[0.07] bg-black/30 p-4">
                <div>
                  <p className="text-sm font-semibold">
                    Display Footer
                  </p>

                  <p className="mt-1 text-xs text-white/30">
                    Show or hide the footer across the storefront.
                  </p>
                </div>

                <button
                  onClick={() =>
                    updateField(
                      "enabled",
                      !footer.enabled
                    )
                  }
                  className={`relative h-7 w-12 shrink-0 rounded-full transition ${
                    footer.enabled
                      ? "bg-amber-400"
                      : "bg-white/10"
                  }`}
                >
                  <span
                    className={`absolute top-1 h-5 w-5 rounded-full bg-white shadow transition ${
                      footer.enabled
                        ? "left-6"
                        : "left-1"
                    }`}
                  />
                </button>
              </div>

              {/* DESCRIPTION */}
              <div>
                <label className="text-sm font-semibold">
                  Brand Description
                </label>

                <p className="mt-1 text-xs text-white/30">
                  A short statement displayed alongside your brand.
                </p>

                <textarea
                  value={footer.description}
                  onChange={(e) =>
                    updateField(
                      "description",
                      e.target.value
                    )
                  }
                  rows={4}
                  className="mt-3 w-full resize-none rounded-2xl border border-white/[0.08] bg-black/40 px-4 py-3.5 text-sm leading-6 text-white outline-none transition placeholder:text-white/20 focus:border-amber-400/40 focus:ring-4 focus:ring-amber-400/[0.05]"
                  placeholder="Tell customers what your brand represents..."
                />
              </div>

              {/* COPYRIGHT */}
              <div>
                <label className="text-sm font-semibold">
                  Copyright
                </label>

                <p className="mt-1 text-xs text-white/30">
                  The copyright line shown at the bottom of the site.
                </p>

                <input
                  value={footer.copyright}
                  onChange={(e) =>
                    updateField(
                      "copyright",
                      e.target.value
                    )
                  }
                  className="mt-3 w-full rounded-2xl border border-white/[0.08] bg-black/40 px-4 py-3.5 text-sm text-white outline-none transition placeholder:text-white/20 focus:border-amber-400/40 focus:ring-4 focus:ring-amber-400/[0.05]"
                  placeholder="© 2026 VÉRANE. All rights reserved."
                />
              </div>

            </div>
          </section>

          {/* NEWSLETTER */}
          <section className="overflow-hidden rounded-[28px] border border-white/[0.08] bg-white/[0.025]">
            <div className="border-b border-white/[0.07] px-6 py-6 sm:px-8">
              <p className="text-[9px] font-bold uppercase tracking-[0.3em] text-amber-400/70">
                02 / Newsletter
              </p>

              <h2 className="mt-2 text-xl font-semibold">
                Newsletter Area
              </h2>

              <p className="mt-1 text-sm text-white/35">
                Control the email signup experience in your footer.
              </p>
            </div>

            <div className="space-y-6 px-6 py-7 sm:px-8">

              <div className="flex items-center justify-between gap-5 rounded-2xl border border-white/[0.07] bg-black/30 p-4">
                <div>
                  <p className="text-sm font-semibold">
                    Enable Newsletter
                  </p>

                  <p className="mt-1 text-xs text-white/30">
                    Display the newsletter signup section.
                  </p>
                </div>

                <button
                  onClick={() =>
                    updateField(
                      "newsletterEnabled",
                      !footer.newsletterEnabled
                    )
                  }
                  className={`relative h-7 w-12 shrink-0 rounded-full transition ${
                    footer.newsletterEnabled
                      ? "bg-amber-400"
                      : "bg-white/10"
                  }`}
                >
                  <span
                    className={`absolute top-1 h-5 w-5 rounded-full bg-white shadow transition ${
                      footer.newsletterEnabled
                        ? "left-6"
                        : "left-1"
                    }`}
                  />
                </button>
              </div>

              <div>
                <label className="text-sm font-semibold">
                  Newsletter Title
                </label>

                <input
                  value={footer.newsletterTitle}
                  onChange={(e) =>
                    updateField(
                      "newsletterTitle",
                      e.target.value
                    )
                  }
                  className="mt-3 w-full rounded-2xl border border-white/[0.08] bg-black/40 px-4 py-3.5 text-sm text-white outline-none transition focus:border-amber-400/40"
                  placeholder="Stay in the know."
                />
              </div>

              <div>
                <label className="text-sm font-semibold">
                  Newsletter Description
                </label>

                <textarea
                  value={footer.newsletterText}
                  onChange={(e) =>
                    updateField(
                      "newsletterText",
                      e.target.value
                    )
                  }
                  rows={3}
                  className="mt-3 w-full resize-none rounded-2xl border border-white/[0.08] bg-black/40 px-4 py-3.5 text-sm leading-6 text-white outline-none transition focus:border-amber-400/40"
                  placeholder="Tell customers what they will receive..."
                />
              </div>

            </div>
          </section>

          {/* SOCIAL */}
          <section className="overflow-hidden rounded-[28px] border border-white/[0.08] bg-white/[0.025]">
            <div className="border-b border-white/[0.07] px-6 py-6 sm:px-8">
              <p className="text-[9px] font-bold uppercase tracking-[0.3em] text-amber-400/70">
                03 / Social
              </p>

              <h2 className="mt-2 text-xl font-semibold">
                Social Links
              </h2>

              <p className="mt-1 text-sm text-white/35">
                Add the social platforms you want customers to discover.
              </p>
            </div>

            <div className="grid gap-5 px-6 py-7 sm:grid-cols-2 sm:px-8">

              <SocialField
                label="Instagram"
                value={footer.instagram}
                onChange={(value) =>
                  updateField("instagram", value)
                }
                placeholder="https://instagram.com/..."
              />

              <SocialField
                label="Facebook"
                value={footer.facebook}
                onChange={(value) =>
                  updateField("facebook", value)
                }
                placeholder="https://facebook.com/..."
              />

              <SocialField
                label="TikTok"
                value={footer.tiktok}
                onChange={(value) =>
                  updateField("tiktok", value)
                }
                placeholder="https://tiktok.com/@..."
              />

              <SocialField
                label="WhatsApp"
                value={footer.whatsapp}
                onChange={(value) =>
                  updateField("whatsapp", value)
                }
                placeholder="https://wa.me/234..."
              />

            </div>
          </section>

          {/* PREVIEW */}
          <section className="overflow-hidden rounded-[28px] border border-white/[0.08] bg-white/[0.025]">
            <div className="border-b border-white/[0.07] px-6 py-6 sm:px-8">
              <p className="text-[9px] font-bold uppercase tracking-[0.3em] text-amber-400/70">
                04 / Preview
              </p>

              <h2 className="mt-2 text-xl font-semibold">
                Footer Preview
              </h2>
            </div>

            <div className="p-4 sm:p-8">
              <div className="overflow-hidden rounded-[24px] border border-white/[0.08] bg-[#080808]">

                <div className="grid gap-10 p-7 sm:grid-cols-2 sm:p-10">

                  <div>
                    <p className="text-2xl font-semibold tracking-[-0.03em]">
                      VÉRANE
                    </p>

                    <p className="mt-4 max-w-sm text-xs leading-6 text-white/35">
                      {footer.description}
                    </p>

                    <div className="mt-5 flex gap-4 text-[10px] uppercase tracking-[0.18em] text-white/30">
                      {footer.instagram && (
                        <span>Instagram</span>
                      )}

                      {footer.facebook && (
                        <span>Facebook</span>
                      )}

                      {footer.tiktok && (
                        <span>TikTok</span>
                      )}

                      {footer.whatsapp && (
                        <span>WhatsApp</span>
                      )}
                    </div>
                  </div>

                  {footer.newsletterEnabled && (
                    <div>
                      <p className="text-lg font-semibold">
                        {footer.newsletterTitle}
                      </p>

                      <p className="mt-2 text-xs leading-6 text-white/35">
                        {footer.newsletterText}
                      </p>

                      <div className="mt-5 flex h-11 items-center rounded-full border border-white/[0.08] bg-white/[0.025] px-4 text-[10px] text-white/20">
                        Enter your email
                      </div>
                    </div>
                  )}

                </div>

                <div className="border-t border-white/[0.06] px-7 py-5 sm:px-10">
                  <p className="text-[9px] uppercase tracking-[0.15em] text-white/20">
                    {footer.copyright}
                  </p>
                </div>

              </div>
            </div>
          </section>

        </div>

        {/* SAVE BAR */}
        <div className="sticky bottom-4 z-20 mt-8">
          <div className="flex flex-col gap-4 rounded-[24px] border border-white/[0.08] bg-black/80 p-4 shadow-2xl shadow-black/50 backdrop-blur-xl sm:flex-row sm:items-center sm:justify-between sm:p-5">

            <div>
              <p className="text-sm font-semibold">
                {saved
                  ? "Footer settings saved"
                  : "Footer configuration"}
              </p>

              <p className="mt-1 text-xs text-white/30">
                {saved
                  ? "Your footer settings have been saved."
                  : "Review your footer settings before saving."}
              </p>
            </div>

            <button
              onClick={saveFooter}
              disabled={saving}
              className="rounded-full bg-amber-400 px-7 py-3.5 text-sm font-bold text-black transition hover:bg-amber-300 hover:shadow-[0_0_30px_rgba(245,185,66,0.15)] disabled:cursor-not-allowed disabled:opacity-60"
            >
              {saving
                ? "Saving..."
                : saved
                  ? "Saved ✓"
                  : "Save Footer"}
            </button>

          </div>
        </div>

      </div>
    </main>
  );
}

function SocialField({
  label,
  value,
  onChange,
  placeholder,
}) {
  return (
    <div>
      <label className="text-sm font-semibold">
        {label}
      </label>

      <input
        value={value || ""}
        onChange={(e) => onChange(e.target.value)}
        placeholder={placeholder}
        className="mt-3 w-full rounded-2xl border border-white/[0.08] bg-black/40 px-4 py-3.5 text-sm text-white outline-none transition placeholder:text-white/20 focus:border-amber-400/40 focus:ring-4 focus:ring-amber-400/[0.05]"
      />
    </div>
  );
}