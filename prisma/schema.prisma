generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_DATABASE_URL")
}

model User {
  id          String        @id @default(cuid())
  email       String        @unique
  password    String
  name        String?
  createdAt   DateTime      @default(now())
  orders      Order[]
  savedLooks  SavedLook[]
  waitingList WaitingList[]
  wishlist    Wishlist[]
}

model Product {
  id                     String                 @id @default(cuid())
  name                   String
  brand                  String
  category               String
  price                  Float
  description            String?
  images                 String
  inventory              Int                    @default(0)
  legacyColors           String?                @map("colors")
  style                  String?
  occasion               String?
  outfitLayer            String                 @default("none")
  outfitCompatible       Boolean                @default(false)
  mannequinAsset         String?
  collectionId           String?
  createdAt              DateTime               @default(now())
  categoryId             String?
  builderAssetUrl        String?
  builderPositionX       Float                  @default(0)
  builderPositionY       Float                  @default(0)
  builderScale           Float                  @default(1)
  initialInventory       Int                    @default(0)
  customSizingEnabled    Boolean                @default(false)
  fulfillmentTime        String?
  preOrderEnabled        Boolean                @default(false)
  sizeType               String?
sizeGuideImage String?
    collaborationProductsA CollaborationProduct[] @relation("CollaborationProductA")
  collaborationProductsB CollaborationProduct[] @relation("CollaborationProductB")
  collaborationVariantA  CollaborationVariant[] @relation("CollaborationVariantA")
  collaborationVariantB  CollaborationVariant[] @relation("CollaborationVariantB")
  orderItems             OrderItem[]
  categoryRef            Category?              @relation(fields: [categoryId], references: [id])
  collection             Collection?            @relation(fields: [collectionId], references: [id])
  productColors          ProductColor[]
  variants               ProductVariant[]
  waitingListEntries     WaitingList[]
  wishlistItems          Wishlist[]

  @@index([brand])
  @@index([categoryId])
  @@index([collectionId])
}

model Category {
  id          String    @id @default(cuid())
  brand       String
  name        String
  slug        String
  description String?
  sizeType    String    @default("none")
  enabled     Boolean   @default(true)
  sortOrder   Int       @default(0)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  products    Product[]

  @@unique([brand, slug])
  @@index([brand])
}

model Collection {
  id          String    @id @default(cuid())
  name        String
  description String?
  image       String?
  enabled     Boolean   @default(true)
  createdAt   DateTime  @default(now())
  brand       String?
  products    Product[]

  @@index([brand])
}

model HomepageSection {
  id                  String   @id @default(cuid())
  key                 String   @unique
  type                String   @default("text")
  enabled             Boolean  @default(true)
  sortOrder           Int      @default(0)
  title               String   @default("")
  subtitle            String   @default("")
  description         String   @default("")
  image               String   @default("")
  mobileImage         String   @default("")
  buttonText          String   @default("")
  buttonLink          String   @default("")
  secondaryButtonText String   @default("")
  secondaryButtonLink String   @default("")
  products            String   @default("[]")
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt
}

model SiteSetting {
  id    String @id @default(cuid())
  key   String @unique
  value String
}

model Order {
  id              String      @id @default(cuid())
  userId          String
  status          String      @default("pending")
  total           Float
  firstName       String?
  lastName        String?
  email           String?
  phone           String?
  address         String?
  city            String?
  state           String?
  createdAt       DateTime    @default(now())
  orderNumber     String      @unique
  user            User        @relation(fields: [userId], references: [id])
  items           OrderItem[]
}

model OrderItem {
  id                 String          @id @default(cuid())
  orderId            String
  productId          String
  quantity           Int
  price              Float
  customMeasurements String?
  selectedColor      String?
  selectedColorHex   String?
  selectedSize       String?
  variantId          String?
  collaborationProductId String?
  collaborationVariantId String?
  order              Order           @relation(fields: [orderId], references: [id])
  product            Product         @relation(fields: [productId], references: [id])
  variant            ProductVariant? @relation(fields: [variantId], references: [id])
  collaborationProduct CollaborationProduct? @relation(fields: [collaborationProductId], references: [id], onDelete: SetNull)

  collaborationVariant CollaborationVariant? @relation(fields: [collaborationVariantId], references: [id], onDelete: SetNull)

  @@index([productId])
  @@index([orderId])
  @@index([variantId])
  @@index([collaborationProductId])
  @@index([collaborationVariantId])
}

model SavedLook {
  id        String   @id @default(cuid())
  userId    String
  products  String
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id])
}

model Subscriber {
  id        String   @id @default(cuid())
  email     String
  createdAt DateTime @default(now())
  brand     String?

  @@unique([email, brand])
  @@index([brand])
}

model Discount {
  id            String    @id @default(cuid())
  brand         String?
  code          String    @unique
  name          String
  description   String?
  type          String
  value         Float
  enabled       Boolean   @default(true)
  minOrderValue Float?
  usageLimit    Int?
  usageCount    Int       @default(0)
  startsAt      DateTime?
  endsAt        DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@index([brand])
}

model ProductVariant {
  id           String        @id @default(cuid())
  productId    String
  stock        Int           @default(0)
  createdAt    DateTime      @default(now())
  initialStock Int           @default(0)
  size         String?
  colorId      String?
    orderItems             OrderItem[]
  collaborationVariantA CollaborationVariant[] @relation("CollaborationVariantA")
  collaborationVariantB CollaborationVariant[] @relation("CollaborationVariantB")

  color        ProductColor? @relation(fields: [colorId], references: [id])
  product      Product       @relation(fields: [productId], references: [id], onDelete: Cascade)
  waitingList  WaitingList[]

  @@index([productId])
  @@index([colorId])
  @@index([productId, size])
  @@index([productId, colorId])
}

model ProductColor {
  id        String           @id @default(cuid())
  productId String
  name      String
  hex       String
  createdAt DateTime         @default(now())
  product   Product          @relation(fields: [productId], references: [id], onDelete: Cascade)
  variants  ProductVariant[]

  @@index([productId])
}

model WaitingList {
  id               String          @id @default(cuid())
  productId        String
  variantId        String?
  userId           String?
  email            String
  selectedColor    String?
  selectedColorHex String?
  selectedSize     String?
  createdAt        DateTime        @default(now())
  product          Product         @relation(fields: [productId], references: [id], onDelete: Cascade)
  user             User?           @relation(fields: [userId], references: [id])
  variant          ProductVariant? @relation(fields: [variantId], references: [id])

  @@index([productId])
  @@index([variantId])
  @@index([userId])
  @@index([email])
}

model CollaborationRequest {
  id              String              @id @default(cuid())
  fromBrand       String
  toBrand         String
  title           String
  message         String?
  status          String              @default("pending")
  collaborationId String?
  createdAt       DateTime            @default(now())
  updatedAt       DateTime            @updatedAt
  notifications   AdminNotification[]
  collaboration   Collaboration?      @relation(fields: [collaborationId], references: [id])

  @@index([fromBrand])
  @@index([toBrand])
  @@index([status])
  @@index([collaborationId])
}

model Collaboration {
  id          String                 @id @default(cuid())
  name        String
  description String?
  brandA      String
  brandB      String
  status      String                 @default("active")
  createdAt   DateTime               @default(now())
  updatedAt   DateTime               @updatedAt
  products    CollaborationProduct[]
  requests    CollaborationRequest[]

  @@index([brandA])
  @@index([brandB])
  @@index([status])
}

model CollaborationProduct {
  id              String        @id @default(cuid())
  collaborationId String
  productAId      String
  productBId      String
  name            String
  description     String?
  price           Float
  images          String        @default("[]")
  status          String        @default("draft")
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  collaboration   Collaboration @relation(fields: [collaborationId], references: [id], onDelete: Cascade)
  productA        Product       @relation("CollaborationProductA", fields: [productAId], references: [id])
  productB        Product       @relation("CollaborationProductB", fields: [productBId], references: [id])

  variants        CollaborationVariant[]

  @@index([collaborationId])
  @@index([productAId])
  @@index([productBId])
  @@index([status])
}

model CollaborationVariant {
  id                    String   @id @default(cuid())
  collaborationProductId String

  // The actual existing variants chosen from each brand
  productAVariantId     String?
  productBVariantId     String?

  // Snapshot of what was selected.
  // This protects the collaboration from later changes
  // to the original product's variant.
  productASize           String?
  productAColor          String?
  productAColorHex       String?

  productBSize           String?
  productBColor          String?
  productBColorHex       String?

  stock                  Int      @default(0)
  initialStock           Int      @default(0)

  createdAt              DateTime @default(now())
  updatedAt              DateTime @updatedAt

  collaborationProduct CollaborationProduct @relation(fields: [collaborationProductId], references: [id], onDelete: Cascade)

  productAVariant ProductVariant? @relation("CollaborationVariantA", fields: [productAVariantId], references: [id])

  productBVariant ProductVariant? @relation("CollaborationVariantB", fields: [productBVariantId], references: [id])

  orderItems             OrderItem[]

  @@index([collaborationProductId])
  @@index([productAVariantId])
  @@index([productBVariantId])
}

model AdminNotification {
  id             String                @id @default(cuid())
  recipientBrand String
  type           String
  title          String
  message        String
  readAt         DateTime?
  requestId      String?
  createdAt      DateTime              @default(now())
  request        CollaborationRequest? @relation(fields: [requestId], references: [id], onDelete: Cascade)

  @@index([recipientBrand])
  @@index([readAt])
  @@index([requestId])
}

model Wishlist {
  id        String   @id @default(cuid())
  userId    String
  productId String
  createdAt DateTime @default(now())
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, productId])
  @@index([userId])
  @@index([productId])
}